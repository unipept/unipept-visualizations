{
    "name": "unipept-visualizations",
    "version": "2.2.5",
    "description": "The Unipept visualisation library",
    "homepage": "https://github.com/unipept/unipept-visualizations",
    "bugs": "https://github.com/unipept/unipept-visualizations/issues",
    "type": "module",
    "main": "dist/unipept-visualizations.js",
    "types": "dist/index.d.ts",
    "files": [
        "dist"
    ],
    "scripts": {
        "test": "vitest run",
        "test:ui": "vitest --ui",
        "lint": "eslint \"src/**/*.ts\"",
        "typecheck": "tsc6 --noEmit",
        "build": "vite build",
        "prepack": "npm run build",
        "dev": "vite",
        "preview": "vite preview"
    },
    "repository": "github:unipept/unipept-visualizations",
    "keywords": [
        "unipept",
        "d3",
        "visualisations"
    ],
    "author": "Team Unipept <unipept@ugent.be>",
    "contributors": [
        "Bart Mesuere",
        "Pieter Verschaffelt"
    ],
    "license": "MIT",
    "dependencies": {
        "@types/d3": "^7.4.3"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/jsdom": "^30.0.0",
        "@typescript-eslint/eslint-plugin": "^8.67.0",
        "@typescript-eslint/parser": "^8.67.0",
        "@vitest/ui": "^4.1.11",
        "canvas": "^3.2.3",
        "d3": "^7.9.0",
        "eslint": "^10.8.1",
        "flush-promises": "^1.0.2",
        "jsdom": "^30.0.1",
        "pixelmatch": "^7.2.0",
        "pngjs": "^7.0.0",
        "puppeteer": "^25.8.0",
        "typescript": "npm:@typescript/typescript6@^6.0.2",
        "vite": "^8.2.1",
        "vite-plugin-dts": "^5.0.3",
        "vitest": "^4.1.11"
    },
    "allowScripts": {
        "canvas": true
    }
}
